// FILE: src/test-harness/prompt-input.ts
//
// Generic prompt-input test harness, shared by every tool's tests/prompt-input/
// suite. Prompt-input tests answer ONE question: "given this user message, does
// the prompt route to the right steps with the right params?"
//
// They run the LIVE model with the project's real prompt + real tool schemas,
// then assert on the STEPS THE MODEL EMITS — before any execution. The backend
// is never called; the runner is never invoked. The boundary is the tool call.
//
// What to assert (via the expect* helpers): the emitted action(s), their order
// or presence, specific param values, and a SPOKEN REPLY (`expectSpokenReply`)
// for branches where the model should ask the user instead of acting.
// What NOT to assert: the exact wording of the reply, or anything post-execution
// (committed state / verdicts) — that is the sandbox layer.
//
// TOOL-CALLING MODE. The harness binds the model the way the graph does, in
// whichever mode the tools were built (`config.tool.toolChoice`):
//   - auto (the bootstrap default): the tools are bound as-is; a spoken reply
//     is an assistant message with no tool call.
//   - required: the tools are bound PER TURN through the library's
//     `modelToolsForTurn` + `modelToolOptions`, exactly as the required-mode
//     agent node binds them; a spoken reply is the sole `respond_to_caller`
//     step, and a turn the model marks `misuse` reads as the
//     `note_refusal` / `malicious_intent` step the runner records for it.
// `expectSpokenReply` and `TurnResult.text` mean the same thing in both.
//
// GATING: these tests hit a live model and cost money, so they are skipped
// unless PROMPT_INPUT_LIVE=1 (and Azure OpenAI creds) are present. Always pass
// `promptInputSkipReason` to the describe's skip option so the suite is a no-op
// in CI / on machines without credentials. The model + tools + llm-env are
// imported LAZILY inside runTurn so this file can be imported (and the suite
// skipped) without any credentials set.

import assert from "node:assert/strict";
import { AIMessage, HumanMessage, ToolMessage } from "@langchain/core/messages";
import type { BaseMessageLike } from "@langchain/core/messages";
import {
  modelToolOptions,
  modelToolsForTurn,
  renderReplyText,
  RESPOND_TO_CALLER_ACTION,
  TURN_FIELD,
  TURN_MISUSE,
  TURN_SERVICE,
} from "../agent-step/index.js";

// Note: `assert` is used internally by the expect* helpers below and is NOT
// re-exported (the sandbox layer owns the `assert` re-export, so the shared
// barrel stays unambiguous). Prompt-input tests should assert through the
// expect* helpers; if you need raw assert, import it from "node:assert/strict".

/** A single `{ action, params }` the model asked the runner to perform. */
export interface EmittedStep {
  action: string;
  params: Record<string, unknown>;
}

/** The outcome of one model turn: the flattened steps it emitted (across all
 *  agent-step tool calls, in order), the raw tool calls, and what the model
 *  SAID — non-empty only when the turn is a spoken reply. In auto mode that is
 *  the assistant text of a turn with no tool call. In required mode it is the
 *  speech control's text as the engine would speak it (placeholders such as
 *  `{read_back}` substituted from the latest tool result); for a
 *  `kind: "clarification"` reply it is the model's explanation alone — the
 *  recap the engine appends is an execution fact, tested at the sandbox layer. */
export interface TurnResult {
  steps: EmittedStep[];
  toolCalls: { name: string; args: Record<string, unknown> }[];
  text: string;
  /** True when the tools were built with `toolChoice: "required"`. */
  requiredMode: boolean;
  raw: AIMessage;
}

/** Whether prompt-input tests should run. */
export function promptInputEnabled(): boolean {
  return process.env.PROMPT_INPUT_LIVE === "1";
}

/** Pass this to a describe's `skip` option:
 *    describe("…", { skip: promptInputEnabled() ? false : promptInputSkipReason }, () => { … }) */
export const promptInputSkipReason =
  "prompt-input tests are skipped — set PROMPT_INPUT_LIVE=1 (with Azure OpenAI creds) to run them";

// ─── Drivers ─────────────────────────────────────────────────────────────────

type Invocable = { invoke: (m: BaseMessageLike[]) => Promise<AIMessage> };

let cachedModel: import("@langchain/openai").AzureChatOpenAI | undefined;
let cachedAutoBinding: Invocable | undefined;

async function chatModel() {
  if (!cachedModel) {
    const { llmEnv } = await import("../llm-env.js");
    const { AzureChatOpenAI } = await import("@langchain/openai");
    cachedModel = new AzureChatOpenAI({
      azureOpenAIApiKey: llmEnv.apiKey,
      azureOpenAIApiInstanceName: new URL(llmEnv.endpoint).hostname.split(".")[0],
      azureOpenAIEndpoint: llmEnv.endpoint,
      azureOpenAIApiDeploymentName: llmEnv.deploymentName,
      azureOpenAIApiVersion: llmEnv.apiVersion,
      temperature: llmEnv.temperature,
    });
  }
  return cachedModel;
}

/** Required-call mode is a property of the TOOL (`config.tool.toolChoice`): a
 *  tool built in that mode carries the library's speech control in its schema,
 *  so the harness reads the mode from the tools instead of importing a config
 *  (this file stays tool-agnostic). `respond_to_caller` is reserved only in
 *  required mode — an AUTO-mode tool must not declare a domain action under
 *  that name, or this reads it as required. */
function builtInRequiredMode(tools: readonly unknown[]): boolean {
  return tools.some((tool) =>
    JSON.stringify((tool as { schema?: unknown }).schema ?? null).includes(
      `"${RESPOND_TO_CALLER_ACTION}"`,
    ),
  );
}

/** Bind the model the way the graph does. Auto: the tools as-is, once (the
 *  bootstrap `createReactAgent` binding). Required: per turn, through the
 *  library's surface narrowing and bind options — the surface depends on the
 *  latest tool result in `messages`, so it is never cached. */
async function boundModel(
  messages: BaseMessageLike[],
): Promise<{ model: Invocable; requiredMode: boolean }> {
  const { tools } = await import("../tools/index.js");
  const model = await chatModel();
  if (!builtInRequiredMode(tools)) {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    cachedAutoBinding ??= model.bindTools(tools as any) as unknown as Invocable;
    return { model: cachedAutoBinding, requiredMode: false };
  }
  const bound = model.bindTools(
    // A fresh array, the SAME tool objects: the library keys each tool's
    // reply scope on its identity.
    modelToolsForTurn([...tools] as unknown[], messages) as never,
    modelToolOptions({ tool: { toolChoice: "required" } }),
  ) as unknown as Invocable;
  return { model: bound, requiredMode: true };
}

function extractSteps(msg: AIMessage): EmittedStep[] {
  const steps: EmittedStep[] = [];
  for (const tc of msg.tool_calls ?? []) {
    // Every agent-step tool is named "<tool>_agent_step" and carries a `steps`
    // array. Collect across all such calls in emission order.
    if (tc.name.endsWith("_agent_step")) {
      // Mirror the runner (required mode): a turn the model marks as misuse is
      // recorded as the `malicious_intent` note IN PLACE of its steps.
      if (tc.args?.[TURN_FIELD] === TURN_MISUSE) {
        steps.push({ action: "note_refusal", params: { kind: "malicious_intent" } });
        continue;
      }
      const arr = (tc.args?.steps ?? []) as EmittedStep[];
      steps.push(...arr);
    }
  }
  return steps;
}

/** History as PRODUCTION writes it. In required mode every agent-step call
 *  carries the `turn` classification, and the model copies the shape of its
 *  own recent calls — a recorded call without the field teaches the next turn
 *  to omit it (and has hidden real routing failures). Add it to any recorded
 *  call that lacks it, listed before `steps` as the model emits it. */
function withRecordedTurn(messages: BaseMessageLike[]): BaseMessageLike[] {
  return messages.map((message) => {
    if (!(message instanceof AIMessage) || (message.tool_calls ?? []).length === 0) return message;
    const toolCalls = (message.tool_calls ?? []).map((tc) => {
      if (!tc.name.endsWith("_agent_step") || TURN_FIELD in (tc.args ?? {})) return tc;
      const first = ((tc.args?.steps ?? []) as EmittedStep[])[0];
      const misuse = first?.action === "note_refusal" && first.params?.kind === "malicious_intent";
      return { ...tc, args: { [TURN_FIELD]: misuse ? TURN_MISUSE : TURN_SERVICE, ...tc.args } };
    });
    return new AIMessage({ content: message.content, id: message.id, tool_calls: toolCalls });
  });
}

/** What a required-mode turn SAID: the sole speech control's text (or a
 *  clarification's explanation), rendered as the engine would speak it. A
 *  reply the engine would refuse — a placeholder the latest result lacks,
 *  fixed bytes left out or altered — fails the test here, with the steps. */
function spokenText(steps: EmittedStep[], messages: BaseMessageLike[]): string {
  if (steps.length !== 1 || steps[0].action !== RESPOND_TO_CALLER_ACTION) return "";
  const params = steps[0].params ?? {};
  const reply = params.kind === "clarification" ? params.explanation : params.text;
  if (typeof reply !== "string") return "";
  try {
    return renderReplyText(reply, messages);
  } catch (cause) {
    throw new Error(`Invalid spoken reply: ${JSON.stringify(steps)}`, { cause });
  }
}

/** Run one model turn over an explicit message list (system prompt is prepended
 *  by the project's buildPrompt). Returns the emitted steps WITHOUT executing
 *  them. Most single-turn tests use {@link runUserTurn}; reach for this when you
 *  need full control over the prior messages. */
export async function runTurn(messages: BaseMessageLike[]): Promise<TurnResult> {
  const { buildPrompt } = await import("../prompt.js");
  // buildPrompt prepends the system message and spreads state.messages after it.
  // awaitingInput / currentFlow are passed for fidelity; the default template
  // does not branch on them, but a customised prompt might.
  const { tools } = await import("../tools/index.js");
  const full = buildPrompt({
    messages: builtInRequiredMode(tools) ? withRecordedTurn(messages) : messages,
    awaitingInput: null,
    currentFlow: null,
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
  } as any) as BaseMessageLike[];
  const { model, requiredMode } = await boundModel(messages);
  const raw = await model.invoke(full);
  const steps = extractSteps(raw);
  if (requiredMode) {
    assert.equal(
      raw.tool_calls?.length,
      1,
      "required tool calling must emit exactly one tool call per model turn",
    );
  }
  return {
    steps,
    toolCalls: (raw.tool_calls ?? []).map((tc) => ({ name: tc.name, args: tc.args })),
    text: requiredMode
      ? spokenText(steps, messages)
      : typeof raw.content === "string"
        ? raw.content
        : JSON.stringify(raw.content),
    requiredMode,
    raw,
  };
}

/** Single-turn convenience: one user utterance, fresh conversation. */
export async function runUserTurn(userText: string): Promise<TurnResult> {
  return runTurn([new HumanMessage(userText)]);
}

/** Build the message history for a PRIOR assistant tool-call turn and its tool
 *  reply, so a multi-turn test can assert on the NEXT turn (recovery paths,
 *  follow-ups). Append the next user message and pass the whole array to
 *  {@link runTurn}:
 *
 *    const history = priorToolTurn({
 *      user: "is my card active?",
 *      toolName: "cards_agent_step",
 *      steps: [{ action: "verify_card", params: { last4: "1234" } }],
 *      reply: { results: [{ action: "verify_card", ok: false, verdict: "card_not_found" }] },
 *    });
 *    const res = await runTurn([...history, new HumanMessage("oh, it ends 5678")]);
 */
export function priorToolTurn(opts: {
  user: string;
  toolName: string;
  steps: EmittedStep[];
  reply: unknown;
  toolCallId?: string;
}): BaseMessageLike[] {
  const id = opts.toolCallId ?? "call_prior_0";
  return [
    new HumanMessage(opts.user),
    new AIMessage({
      content: "",
      tool_calls: [{ id, name: opts.toolName, args: { steps: opts.steps } }],
    }),
    new ToolMessage({
      content: typeof opts.reply === "string" ? opts.reply : JSON.stringify(opts.reply),
      tool_call_id: id,
    }),
  ];
}

// ─── Assertions over emitted steps ───────────────────────────────────────────

/** The step at `index` is `action`. */
export function expectAction(steps: EmittedStep[], index: number, action: string): void {
  assert.equal(
    steps[index]?.action,
    action,
    `expected step[${index}] to be "${action}", got ${describe(steps)}`,
  );
}

/** The emitted actions, in order, are exactly `actions`. Use when the model has
 *  no latitude over ordering. */
export function expectActionsInOrder(steps: EmittedStep[], actions: string[]): void {
  assert.deepEqual(
    steps.map((s) => s.action),
    actions,
    `expected actions ${JSON.stringify(actions)}, got ${describe(steps)}`,
  );
}

/** `action` appears somewhere in the batch (order-independent). */
export function expectActionPresent(steps: EmittedStep[], action: string): void {
  assert.ok(
    steps.some((s) => s.action === action),
    `expected "${action}" to be present, got ${describe(steps)}`,
  );
}

/** `action` does NOT appear (e.g. a forbidden action the model must not emit). */
export function expectActionAbsent(steps: EmittedStep[], action: string): void {
  assert.ok(
    !steps.some((s) => s.action === action),
    `expected "${action}" to be absent, got ${describe(steps)}`,
  );
}

/** The first step for `action` carries `params[key] === value`. */
export function expectParam(
  steps: EmittedStep[],
  action: string,
  key: string,
  value: unknown,
): void {
  const step = steps.find((s) => s.action === action);
  assert.ok(step, `expected a "${action}" step, got ${describe(steps)}`);
  assert.deepEqual(
    step.params[key],
    value,
    `expected ${action}.params.${key} === ${JSON.stringify(value)}, got ${JSON.stringify(step.params[key])}`,
  );
}

/** The first step for `action` has a `params[key]` satisfying `predicate`. Use
 *  when the model has latitude over the exact representation (e.g. an ambiguous
 *  spoken number that may produce one of several acceptable forms). */
export function expectParamMatches(
  steps: EmittedStep[],
  action: string,
  key: string,
  predicate: (value: unknown) => boolean,
): void {
  const step = steps.find((s) => s.action === action);
  assert.ok(step, `expected a "${action}" step, got ${describe(steps)}`);
  assert.ok(
    predicate(step.params[key]),
    `expected ${action}.params.${key} to satisfy predicate, got ${JSON.stringify(step.params[key])}`,
  );
}

/** The model SPOKE instead of acting — it should have asked or answered the
 *  user. Works in both tool-calling modes: auto → no tool call at all;
 *  required → the sole speech control with a non-empty reply (no operation or
 *  handoff may ride along). Prefer this over {@link expectNoToolCall}. */
export function expectSpokenReply(result: TurnResult): void {
  if (!result.requiredMode) {
    assert.equal(
      result.toolCalls.length,
      0,
      `expected a spoken reply with no tool call, got ${describe(result.steps)}`,
    );
    return;
  }
  assert.deepEqual(
    result.steps.map((s) => s.action),
    [RESPOND_TO_CALLER_ACTION],
    `expected the sole speech step, got ${describe(result.steps)}`,
  );
  assert.ok(result.text.trim(), "a speech step must carry a non-empty reply");
}

/** AUTO MODE ONLY: the model called no tool. In required mode every turn is a
 *  tool call, so this can never hold — assert {@link expectSpokenReply}. */
export function expectNoToolCall(result: TurnResult): void {
  assert.equal(
    result.requiredMode,
    false,
    "required tool calling has no tool-free turn — use expectSpokenReply",
  );
  assert.equal(
    result.toolCalls.length,
    0,
    `expected no tool call, got ${describe(result.steps)}`,
  );
}

/** Content sanity check for the channel — pass a regex the reply must match
 *  (e.g. a script/locale check). NEVER assert the exact wording. */
export function expectContentMatches(result: TurnResult, pattern: RegExp): void {
  assert.match(result.text, pattern);
}

function describe(steps: EmittedStep[]): string {
  return JSON.stringify(steps.map((s) => s.action));
}
