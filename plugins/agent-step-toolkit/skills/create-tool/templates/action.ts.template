// FILE: src/tools/{{TOOL_NAME}}/actions/{{ACTION_NAME}}/action.ts
//
// The `{{ACTION_NAME}}` DECLARATION — schema, description, verdict rows,
// controller — beside the executor that names those verdicts and the
// selector that feeds it.
//
