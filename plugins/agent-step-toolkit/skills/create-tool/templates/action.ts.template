import { z } from "zod";
import type { State } from "../../../../state.js";
import type { ActionDef } from "../../../../agent-step/index.js";
import type { PrereqName } from "../../names.js";

export const {{ACTION_CAMEL}}Action: ActionDef<PrereqName, State> = {
  summary: "{{ONE_LINE_ACTION_SUMMARY}}",
  // SEMANTIC LEAD ONLY: what the action means for the business process, its
  // param semantics, and what `ok` changes. The gate handshake and the
  // verdict mechanics are ENGINE-COMPOSED (compile/action-describe.ts
  // prepends the gate marker; results explain their own verdicts) — never
  // restate them here.
  description:
    "{{ACTION_LLM_DESCRIPTION}}",
  paramsSchema: z.object({
    // {{ACTION_PARAMS}}
    // Every param declares WHAT IT IS through a library builder, which
    // registers a machine-readable field kind the engine reads:
    //   digits — `callerDigits`, `digitGroupsParam`, `digitCandidatesParam`
    //   text   — `callerTextParam`
    //   judged — `judgedEnum(values, describe)`, `judgedFlag(describe)`: the
    //            model's classification of what the caller meant
    //   relay  — `relayParam(describe)`: the caller's exact words, passed on
    // Only `digits` / `text` are caller CAPTURES — the only params a standing
    // ask may target. Use the builder's result unchanged (a later
    // `.optional()` / `.describe()` makes a new schema and loses the kind).
    // Value-shape rules are REFINEMENTS: a `.regex()` / `.min()` / `.max()` /
    // `.email()` on a model-facing string surfaces as a JSON-Schema keyword
    // and FAILS CONSTRUCTION. XOR over optional selectors:
    // `.superRefine(exactlyOneOf(["a", "b"], message))`.
    // See agent-step-api.md <caller_digit_capture>.
  }),
  prereqs: [{{ACTION_PREREQS}}],

  // ─── Declared verdict rows — the executor's result space ──────────────── //
  // The executor returns `{ verdict, data?, stateUpdate?, effects?,
  // resultExtras? }` and the runner composes the wire body from the named
  // row. STATIC doctrine strings live here (one authority); only genuinely
  // branch-dependent values ride the executor's `data`. `body` fields are
  // composed IN DECLARATION ORDER after `summary`; a function field receives
  // `data`; `summary` may be a `(state, data) => string` renderer for
  // language-keyed catalogs. A verdict with no row fails loudly as
  // `executor_error`; an action with NO rows fails construction.
  //
  // REGISTER: a row's `summary` is CALLER-AUDIBLE host text the model relays
  // faithfully. What the model should DO about the outcome is model-facing
  // doctrine and rides a `body` field (e.g. `reason`).
  verdicts: {
    ok: {
      ok: true,
      summary: "{{OK_SUMMARY}}",
      body: { verdict: "ok" },
      // Static state write for this verdict (typed against State; the
      // executor's dynamic `stateUpdate` wins on key conflicts):
      // stateUpdate: { {{STATE_FIELD}}: {{STATIC_VALUE}} },
    },
    {{FAILURE_VERDICT}}: {
      ok: false,
      summary: "{{FAILURE_SUMMARY}}",
      body: {
        verdict: "{{FAILURE_VERDICT}}",
        error: "{{FAILURE_ERROR_CODE}}",
        // Dynamic diagnostic from the executor's `data`:
        // reason: (data) => data.reason,
      },
      // Mark a backend failure so the auto-handoff counter sees this code
      // (requires body.error to be a static string):
      // backendFailure: true,
      //
      // STANDING ASK — declare it ON the row whose outcome asks the question.
      // When this row is the batch's FINAL entry, the engine records the ask
      // as the `dictation` awaiting-input state and stamps `standing_ask` +
      // `ask_contract` (and `ask_text` when `render` returns bytes) on that
      // entry. Non-locking: it records the standing question; capturing the
      // answer stays the model's job.
      //   ask: "self",                         // re-ask THIS action's capture
      //   ask: { action: "{{NEXT_ACTION}}" },  // the answer feeds another action
      //   ask: { action: "{{NEXT_ACTION}}", param: "{{CAPTURE_PARAM}}",   // only when the target has SEVERAL captures
      //          render: (state) => "{{EXACT_ASK_SENTENCE}}" },           // engine-rendered bytes, spoken verbatim
      // `param` defaults to the target's sole capture field and digits-vs-text
      // is derived from that field's kind. A row that declares NO ask and
      // whose action owned the standing ask has serviced it (the record
      // clears). The `invalid_params` re-ask is DERIVED from this action's own
      // capture field — never declare it. A terminal row (one carrying a
      // `request_handoff` effect) may not ask.
    },
    // A TERMINAL verdict arms its handoff atomically with the outcome write —
    // the two can never fork:
    // {{TERMINAL_VERDICT}}: {
    //   ok: false,
    //   summary: "{{TERMINAL_SUMMARY}}",
    //   body: { verdict: "{{TERMINAL_VERDICT}}" },
    //   stateUpdate: { {{OUTCOME_SLOT}}: "{{TERMINAL_VERDICT}}" },
    //   effects: [{ type: "request_handoff", request: { reason: "{{HANDOFF_REASON}}", context: "{{HANDOFF_CONTEXT}}" } }],
    // },
  },

  // ─── Bounced captures need NO declaration ─────────────────────────────── //
  // A capture that fails its refinement bounces as `invalid_params` before
  // any executor runs. With `handoff` configured the engine bounds it by
  // itself, for every action alike — at the default tolerances (deployment-
  // level AGENT_STEP_* env, never declared here): two consecutive bounces
  // re-ask plainly, the next earns ONE in-place explanation, and the one after hands back
  // `abandon` on the structural context `agent-step:escalated:{{ACTION_NAME}}`
  // (map it to a closing in the handoff spec). Any call whose params parse
  // resets the count. Only an action with SEVERAL capture fields declares
  // which one a bounce leaves owed:
  // bounceCapture: "{{CAPTURE_PARAM}}",

  // ─── State-satisfied inputs (optional) ────────────────────────────────── //
  // The action's input may already be in state (carried by the channel from
  // earlier in the call, or asserted by an authenticated session). An EMPTY
  // call — no capture field supplied — is then answered from state instead of
  // re-asking; a dictated capture always wins. The resolved values reach the
  // executor as its third argument and never reach the model.
  // satisfies: {
  //   values: { {{CAPTURE_PARAM}}: "{{STATE_SLOT}}.{{FIELD}}" },  // bundle name → dotted state path
  //   mode: "consent",          // rides THIS action's confirmation gate; "silent" = ungated, executes at once
  //   ask: (state) => "{{REUSE_CONSENT_QUESTION}}",   // consent only: the gate's read_back
  //   elseVerdict: "{{NOTHING_CARRIED_VERDICT}}",     // consent only: the row answering when nothing usable is carried
  // },

  // ─── Controller lifecycle (optional) ──────────────────────────────────── //
  controller: {
    // `soleOnExecute` lets propose/re-propose ride as the LAST step of a
    // multi-step batch while the execute re-call must be the only step. Use
    // strict `soleStep: true` instead if the action must never share a batch.
    soleOnExecute: true,
    // requiresConfirmation opts:
    //   maxAttempts — re-propose budget before the gate exhausts (default 3).
    //   lockdown    — defaults to true (unrelated batches refused while pending).
    //   readBack    — (params, state) => string: render what the RUNNER
    //                 recorded so the model speaks it back verbatim. Add it
    //                 whenever params carry caller-dictated digits.
    //   readBackDirective — (params, state) => string: how the model must
    //                 FRAME the read_back (what may precede/follow the bytes);
    //                 rides the proposal as `read_back_directive`.
    //   repeatReadBack — persist the rendering on the gate and inject the
    //                 sole-step `repeat_pending_question` control: a
    //                 "pardon?" turn returns the EXACT stored bytes without
    //                 confirming or spending an attempt. REQUIRES replyContract.
    //   replyContract — a GateContractSpec ({ subject, subjectNoun,
    //                 executesLabel, categories }): the engine composes the
    //                 full reply contract for THIS gate (frame clauses engine-
    //                 owned, domain categories host-owned) replacing the
    //                 generic template. For gates whose reply taxonomy the
    //                 generic yes/correction contract cannot cover.
    //   refuseProposal — (params, state) => { verdict, data? } | null:
    //                 propose-time, STATE-aware refusal answered through a
    //                 DECLARED row (no gate stored, no attempt spent).
    // There is deliberately NO TTL — stale gates clear via
    // `abort_pending_input` or executor effects.
    requiresConfirmation: { maxAttempts: 3 },
  },

  // Downstream-slot invalidation is NOT declared per action: staleness is a
  // fact about the slots, whoever writes them. See `invalidations` in
  // ../../config.ts.
};

// ─── Other lifecycle opts available on `controller` (use as needed) ──────── //
//
// Multi-turn flow lifecycle (one flow at a time; library enforces flow mutex):
//   startsFlow:    { name: "{{flow_name}}" }     — opens the flow on `ok`.
//   requiresFlow:  "{{flow_name}}"               — refuse unless flow matches.
//   endsFlow:      true                           — clears flow + awaitingInput on `ok`.
//
// SCA / OTP gating (library never counts OTP attempts; backend is authoritative):
//   issuesOtp:     { consumer_action: "confirm_otp" }
//   requiresOtp:   true
//
// Double-entry verification (PIN repeat, password repeat):
//   startsMatchFor:{ consumer_action: "commit_x" }
//   requiresMatch: { capturer: "propose_x", maxAttempts: 3 }
//
// Read pagination is a top-level ActionDef field (not a controller opt):
//   pageable: true | "delegate" | { mode, pageSize, maxPageSize }
// The runner injects `page`/`pageSize` and emits a uniform envelope. A
// pageable action's paramsSchema MUST be a PLAIN z.object (a refined schema
// cannot be page-extended). See executor-read-paginated.
//
// See `references/agent-step-api.md` for the full lifecycle table.
